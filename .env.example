# Recommended provider: OpenRouter. Do not append /chat/completions.
OPENROUTER_API_KEY=
PRESENTATION_LLM_BASE_URL=https://openrouter.ai/api/v1
PRESENTATION_LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
PRESENTATION_LLM_FALLBACK_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free

# The same OpenRouter endpoint and key are used for image understanding.
PRESENTATION_VLM_BASE_URL=https://openrouter.ai/api/v1
PRESENTATION_VLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
PRESENTATION_VLM_FALLBACK_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free

PRESENTATION_LLM_JSON_MODE=1
PRESENTATION_LLM_REASONING=0
PRESENTATION_LLM_MAX_TOKENS=4096
PRESENTATION_LLM_TEMPERATURE=0.2
PRESENTATION_LLM_LAYOUT_LIMIT=12
PRESENTATION_SERVICE_DATA_DIR=service_data
PRESENTATION_WORKERS=2
PRESENTATION_HOST=0.0.0.0
PRESENTATION_PORT=8000
PRESENTATION_MAX_TEMPLATE_BYTES=104857600
PRESENTATION_MAX_CONTENT_BYTES=524288000
